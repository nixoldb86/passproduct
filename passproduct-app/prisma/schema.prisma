generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                 @id @default(cuid())
  clerkId                 String                 @unique
  email                   String                 @unique
  firstName               String?
  lastName                String?
  avatarUrl               String?
  country                 String                 @default("ES")
  language                String                 @default("es")
  lastSeen                DateTime               @default(now())
  showLastSeen            Boolean                @default(true)
  showReadReceipts        Boolean                @default(true)
  phone                   String?
  phoneVerified           Boolean                @default(false)
  phoneVerificationCode   String?
  phoneVerificationExpiry DateTime?
  isIdentityVerified      Boolean                @default(false)
  identityVerifiedAt      DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  buyerConversations      Conversation[]         @relation("BuyerConversations")
  sellerConversations     Conversation[]         @relation("SellerConversations")
  disputes                Dispute[]
  identityVerifications   IdentityVerification[]
  listings                Listing[]
  messages                Message[]
  buyerOrders             Order[]                @relation("BuyerOrders")
  sellerOrders            Order[]                @relation("SellerOrders")
  products                Product[]

  @@index([clerkId])
  @@index([email])
}

model IdentityVerification {
  id                 String                     @id @default(cuid())
  userId             String
  documentType       String
  documentNumberHash String
  documentCountry    String                     @default("ES")
  firstNameExtracted String?
  lastNameExtracted  String?
  dateOfBirth        DateTime?
  expirationDate     DateTime?
  status             IdentityVerificationStatus @default(PENDING)
  faceMatchScore     Float?
  livenessScore      Float?
  ocrConfidence      Float?
  rejectionReason    String?
  ipAddress          String?
  userAgent          String?
  startedAt          DateTime                   @default(now())
  completedAt        DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentNumberHash])
  @@index([status])
}

model Category {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  icon            String?
  parentId        String?
  attributeSchema Json?
  minPhotos       Int        @default(2)
  requiresTicket  Boolean    @default(false)
  requiresSerial  Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  parent          Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryChildren")
  listings        Listing[]
  products        Product[]

  @@index([slug])
  @@index([parentId])
}

model Product {
  id                      String           @id @default(cuid())
  userId                  String
  categoryId              String
  brand                   String
  model                   String
  variant                 String?
  condition               ProductCondition
  purchaseDate            DateTime?
  purchasePrice           Decimal?         @db.Decimal(10, 2)
  purchaseStore           String?
  proofOfPurchaseUrl      String?
  warrantyEndDate         DateTime?
  imeiHash                String?
  imeiLast4               String?
  serialHash              String?
  serialLast4             String?
  photos                  String[]
  accessories             Json?
  attributes              Json?
  estimatedValue          Decimal?         @db.Decimal(10, 2)
  estimatedValueUpdatedAt DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  listings                Listing[]
  category                Category         @relation(fields: [categoryId], references: [id])
  user                    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([categoryId])
  @@index([brand, model])
}

model Listing {
  id                     String            @id @default(cuid())
  productId              String?
  sellerId               String
  categoryId             String
  title                  String
  description            String
  price                  Decimal           @db.Decimal(10, 2)
  location               String?
  latitude               Decimal?          @db.Decimal(10, 8)
  longitude              Decimal?          @db.Decimal(11, 8)
  shippingEnabled        Boolean           @default(false)
  shippingCost           Decimal?          @db.Decimal(10, 2)
  verificationLevel      VerificationLevel @default(LEVEL_0)
  hasVerifiedPurchase    Boolean           @default(false)
  hasValidWarranty       Boolean           @default(false)
  hasVerifiedAccessories Boolean           @default(false)
  hasVerifiedIdentifier  Boolean           @default(false)
  status                 ListingStatus     @default(DRAFT)
  photos                 String[]
  isBoosted              Boolean           @default(false)
  boostedUntil           DateTime?
  viewCount              Int               @default(0)
  favoriteCount          Int               @default(0)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  publishedAt            DateTime?
  soldAt                 DateTime?
  conversations          Conversation[]
  category               Category          @relation(fields: [categoryId], references: [id])
  product                Product?          @relation(fields: [productId], references: [id])
  seller                 User              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  orders                 Order[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([price])
  @@index([location])
  @@index([createdAt])
  @@index([productId]) // Optimiza búsquedas por producto
}

model Conversation {
  id              String    @id @default(cuid())
  listingId       String
  buyerId         String
  sellerId        String
  currentOffer    Decimal?  @db.Decimal(10, 2)
  offerStatus     String?
  deletedByBuyer  Boolean   @default(false)
  deletedBySeller Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  buyer           User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  listing         Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller          User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([buyerId, deletedByBuyer])  // Optimiza filtrado de conversaciones del comprador
  @@index([sellerId, deletedBySeller]) // Optimiza filtrado de conversaciones del vendedor
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  senderId        String
  text            String
  isOffer         Boolean      @default(false)
  offerAmount     Decimal?     @db.Decimal(10, 2)
  isSystemMessage Boolean      @default(false)
  readAt          DateTime?
  createdAt       DateTime     @default(now())
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([conversationId, senderId, readAt]) // Optimiza marcado de mensajes como leídos
}

model Order {
  id                    String      @id @default(cuid())
  listingId             String
  buyerId               String
  sellerId              String
  amount                Decimal     @db.Decimal(10, 2)
  shippingAmount        Decimal     @default(0) @db.Decimal(10, 2)
  feeMarketplace        Decimal     @db.Decimal(10, 2)
  feeProtection         Decimal     @db.Decimal(10, 2)
  total                 Decimal     @db.Decimal(10, 2)
  sellerPayout          Decimal     @db.Decimal(10, 2)
  status                OrderStatus @default(CREATED)
  stripePaymentIntentId String?     @unique
  stripePaymentStatus   String?
  protectionCode        String?
  protectionCodeUsed    Boolean     @default(false)
  codeVerifiedAt        DateTime?
  shippingAddress       Json?
  trackingNumber        String?
  carrier               String?
  isLocalPickup         Boolean     @default(false)
  unboxingVideoUrl      String?
  paidAt                DateTime?
  escrowAt              DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  acceptedAt            DateTime?
  releasedAt            DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  disputes              Dispute[]
  buyer                 User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  listing               Listing     @relation(fields: [listingId], references: [id])
  seller                User        @relation("SellerOrders", fields: [sellerId], references: [id])

  @@index([buyerId])
  @@index([sellerId])
  @@index([listingId])
  @@index([status])
  @@index([stripePaymentIntentId])
}

model Dispute {
  id           String          @id @default(cuid())
  orderId      String
  openedById   String
  reason       DisputeReason
  description  String
  evidenceUrls String[]
  status       DisputeStatus   @default(OPENED)
  outcome      DisputeOutcome?
  adminNotes   String?
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  openedBy     User            @relation(fields: [openedById], references: [id])
  order        Order           @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([openedById])
  @@index([status])
}

model PriceHistory {
  id         String           @id @default(cuid())
  brand      String
  model      String
  variant    String?
  condition  ProductCondition
  minPrice   Decimal          @db.Decimal(10, 2)
  avgPrice   Decimal          @db.Decimal(10, 2)
  maxPrice   Decimal          @db.Decimal(10, 2)
  source     String?
  recordedAt DateTime         @default(now())

  @@index([brand, model, variant])
  @@index([recordedAt])
}

model Alert {
  id        String   @id @default(cuid())
  userId    String
  productId String?
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  type           NotificationType
  title          String
  message        String
  fromUserId     String?
  listingId      String?
  conversationId String?
  orderId        String?
  imageUrl       String?
  actionUrl      String?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

enum ProductCondition {
  NEW
  LIKE_NEW
  VERY_GOOD
  GOOD
  ACCEPTABLE
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  RESERVED
  SOLD
  CANCELLED
}

enum VerificationLevel {
  LEVEL_0
  LEVEL_1
  LEVEL_2
}

enum OrderStatus {
  CREATED
  PAID
  ESCROW_HOLD
  SHIPPED
  HANDED_OVER
  DELIVERED
  ACCEPTED
  RELEASED
  DISPUTED
  REFUNDED
}

enum DisputeReason {
  NOT_RECEIVED
  NOT_AS_DESCRIBED
  NOT_WORKING
}

enum DisputeStatus {
  OPENED
  UNDER_REVIEW
  RESOLVED
}

enum DisputeOutcome {
  RELEASE
  REFUND
  RETURN
}

enum IdentityVerificationStatus {
  PENDING
  PROCESSING
  VERIFIED
  REJECTED
  EXPIRED
}

enum NotificationType {
  NEW_LISTING
  PRICE_DROP
  NEW_FOLLOWER
  ORDER_UPDATE
  MESSAGE
  SYSTEM
}
